{
  "name": "gd-pe-teacher-assistant",
  "version": "1.0.2",
  "private": true,
  "description": "广东省初中体育教师管理助手",
  "author": "广东省初中体育教师管理助手",
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "check:pe-test": "node scripts/check-pe-test.mjs",
    "check:pe-test-selfchecks": "node scripts/check-pe-test-selfchecks.mjs",
    "check:data-safety": "node scripts/check-data-safety.mjs",
    "check:classroom": "node scripts/check-classroom.mjs",
    "check:classroom-selfchecks": "node scripts/check-classroom-selfchecks.mjs",
    "check:schedule-training": "node scripts/check-schedule-training.mjs",
    "check:node": "tsc --noEmit -p tsconfig.node.json",
    "check:web": "tsc --noEmit -p tsconfig.web.json",
    "dev:web": "vite --config vite.web.config.ts",
    "build:web": "node scripts/generate-companion-icons.mjs && vite build --config vite.web.config.ts",
    "package:win": "npm run build && node scripts/package-windows.mjs dir",
    "dist:win": "npm run build && node scripts/package-windows.mjs nsis",
    "dist:win:publish": "npm run build && node scripts/package-windows.mjs nsis publish",
    "check:selfchecks": "node scripts/check-all-selfchecks.mjs",
    "check:rc": "node scripts/check-rc.mjs",
    "check:packaged": "node scripts/packaged-smoke.mjs",
    "check:release": "node scripts/check-release.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "pdfjs-dist": "4.10.38",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "electron": "^37.3.1",
    "electron-builder": "26.15.0",
    "electron-vite": "^4.0.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  }
}
